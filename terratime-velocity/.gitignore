# Virtual environment
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Generated data (regenerate with `python -m terratime.cli run`)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated viewer data payload (regenerated by `terratime run`)
viewer/data/*.js

# Earth Engine credentials, if ever configured locally
.config/earthengine/
